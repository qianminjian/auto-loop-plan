# atdo 项目开发工作目录
# 真实源码在开发目录本身（SKILL.md / scripts/ / references/），
# install.sh 部署到 ~/.agents/skills/atdo/，不在此目录

# ── 过程材料（不纳入 git）──
#   _proc-use/dev/      安装/卸载脚本（开发过程调试用）
#   _proc-use/reports/  运行时审计/测试报告（每次执行产生）
#   _proc-use/buginfo/  Bug 报告（过程性）
#   注：项目设计文档已统一到根目录 doc/（git 跟踪），_proc-use/ 仅保留过程性产物
_proc-use/

# ── atdo 运行时状态（防御性:本仓库不应产生,但 user 可能误用) ──
.phase-execution/

# ── 系统文件 ──
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── 临时文件 ──
*.tmp
*.log
*~
