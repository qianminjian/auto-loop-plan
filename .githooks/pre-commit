#!/bin/sh
# atdo pre-commit hook (可选启用: git config core.hooksPath .githooks)
# 失败 → 拒绝 commit；成功 → 静默通过

set -e

echo "[pre-commit] running atdo tests..."
node _proc-use/reports/atdo.test.js > /dev/null

echo "[pre-commit] running markdownlint..."
npx --yes markdownlint-cli2 README.md SKILL.md doc/*.md doc/archive/*.md > /dev/null

echo "[pre-commit] ✅ all checks passed"
